# Nix build results
/result
/result-*

# Scratch space
/.scratch/

# Gradle
/.gradle/
/.gradle-user-home/
/build/
/libs/

# Game data created by the run tasks
/run/

# Datagen output
/src/generated/resources/

# IDE
/.idea/
*.iml

# Local scratch (decompiled sources, nix fetcher cache)
/.work/
/.nix-cache/

# Python bytecode
__pycache__/
*.pyc

# Generated Blockbench exports (run tools/export_blockbench.py locally)
/docs/blockbench/*.bbmodel
/docs/blockbench/flat/

# Logs and crash dumps
*.log
/logs/
hs_err_pid*
